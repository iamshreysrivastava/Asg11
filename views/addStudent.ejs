<%- include("partials/header") %>

<div class="card shadow-lg p-5 form-card">

    <h2 class="text-center mb-4 text-primary">
        Add Student
    </h2>

    <form method="POST" action="/students/add">

        <div class="row">

            <div class="col-md-6 mb-3">
                <input type="text" name="name" class="form-control" placeholder="Enter Name" required>
            </div>

            <div class="col-md-6 mb-3">
                <input type="number" name="rollno" class="form-control" placeholder="Enter Roll Number" required>
            </div>

            <div class="col-md-6 mb-3">
                <input type="text" name="course" class="form-control" placeholder="Enter Course" required>
            </div>

            <div class="col-md-6 mb-3">
                <input type="number" name="age" class="form-control" placeholder="Enter Age" required>
            </div>

            <div class="col-md-6 mb-3">
                <input type="email" name="email" class="form-control" placeholder="Enter Email" required>
            </div>

            <div class="col-md-6 mb-3">
                <input type="text" name="city" class="form-control" placeholder="Enter City" required>
            </div>

        </div>

        <button class="btn btn-primary w-100">
            Add Student
        </button>

    </form>

</div>

<%- include("partials/footer") %>