<%- include("partials/header") %>

<div class="card shadow-lg p-5 form-card">

    <h2 class="text-center mb-4 text-warning">
        Edit Student
    </h2>

    <form method="POST" action="/students/update/<%= student._id %>">

        <div class="row">

            <div class="col-md-6 mb-3">
                <input type="text" name="name" class="form-control" value="<%= student.name %>">
            </div>

            <div class="col-md-6 mb-3">
                <input type="number" name="rollno" class="form-control" value="<%= student.rollno %>" readonly>
            </div>

            <div class="col-md-6 mb-3">
                <input type="text" name="course" class="form-control" value="<%= student.course %>">
            </div>

            <div class="col-md-6 mb-3">
                <input type="number" name="age" class="form-control" value="<%= student.age %>">
            </div>

            <div class="col-md-6 mb-3">
                <input type="email" name="email" class="form-control" value="<%= student.email %>">
            </div>

            <div class="col-md-6 mb-3">
                <input type="text" name="city" class="form-control" value="<%= student.city %>">
            </div>

        </div>

        <button class="btn btn-warning w-100">
            Update Student
        </button>

    </form>

</div>

<%- include("partials/footer") %>